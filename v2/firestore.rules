rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// 장원급제반 Firestore 보안규칙
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 탭 → 전체 붙여넣기 → 게시
//
// ⚠️ 기존 규칙에서 바뀌는 점
//   - /schedule 은 기존 그대로 유지(앱에서 방과후 시간표를 직접 편집하므로 건드리면 안 됨)
//   - /asCheckIn  추가 — 학생 방과후 출석 체크인(신규)
//   - /asOverride 추가 — 교사 출석 정정(신규)
//   - /members    추가 — 스트릭 프리즈 구매만 좁게 허용
//   - 그 외는 기존과 동일하게 읽기만 허용, 쓰기는 GAS(서비스 계정)만
//
// ── 2026-09-14 교사 로그인 도입 ────────────────────────────────
//   - /admins    추가 — 교사 UID 명단(콘솔에서만 생성)
//   - isTeacher() 로 /asOverride 를 교사 전용으로 잠금(전에는 완전 개방)
//   - /asCheckIn, /streakFreeze 쓰기에 signedIn() 요구
//   - ⚠️ 구앱은 인증을 안 쓴다(request.auth == null). /schedule 쓰기와
//     모든 읽기에는 인증을 걸지 않았다 — 걸면 학생들 구앱이 즉시 깨진다.
//
// ── 2026-09-14 등교 출결 v2 이전 ───────────────────────────────
//   - /amCheckIn  추가 — 학생 등교 인증(KST 06:00~08:30)
//   - /amOverride 추가 — 교사 등교 출결 정정(교사만)
//
// 참고: Firestore 규칙은 "먼저 매칭된 것이 이긴다"가 아니라 **하나라도 허용하면 통과**다.
//       그래서 아래 구체 규칙들과 맨 끝 catch-all(write:false)이 공존해도 문제 없다.
//
// ⚠️ 시간은 전부 한국시간(KST=UTC+9) 기준. request.time은 UTC라 환산해서 비교한다.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // UTC 자정 기준 경과 분(0~1439)
    function utcMinutes() {
      return request.time.hours() * 60 + request.time.minutes();
    }

    // ── 신원 ────────────────────────────────────────────
    // 학생 = 익명 인증(앱이 열릴 때 조용히 로그인). 화면 변화 없음.
    // 교사 = 이메일·비밀번호 계정 중 아래 화이트리스트에 있는 사람만.
    //
    // ⚠️ 이메일/비밀번호 제공업체가 켜져 있으면 누구나 스스로 계정을
    //    만들 수 있다. "이메일 계정이 있다"는 교사의 근거가 못 된다.
    //    반드시 UID로 못박거나 admins 문서로 확인할 것.
    // ⚠️ 구앱(index.html)은 인증을 쓰지 않아 request.auth 가 null이다.
    //    그래서 구앱이 건드리는 /schedule 과 읽기 권한에는
    //    signedIn()/isTeacher()를 절대 걸면 안 된다.
    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return request.auth != null
        && ( request.auth.uid == 'c5BpZGuLVtZmKep0xq3DVeCUBij1'
             // 방과후 강사를 추가할 땐 규칙 재게시 없이 문서 하나만 만들면 된다
             || exists(/databases/$(database)/documents/admins/$(request.auth.uid)) );
    }

    // ── 교사 명단 ───────────────────────────────────────
    // 문서 ID = 교사의 UID. 생성은 Firebase 콘솔에서만(클라이언트 쓰기 금지).
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ── 방과후 시간표 (기존 그대로 — 절대 건드리지 말 것) ──────
    // 교사가 앱에서 시간표를 직접 편집하므로 쓰기가 열려 있어야 한다.
    match /schedule/{docId} {
      allow read, write: if true;
    }

    // ── 방과후 출석 체크인 (신규) ──────────────────────────
    // 학생이 수업 시작(18:30 KST) 이후 그날 24시(KST)까지 직접 찍는다.
    // 결석은 저장하지 않는다 — 기록이 없으면 결석으로 계산하므로,
    // 자정이 지나면 자동으로 결석이 확정된다(마감 트리거 불필요).
    //
    // KST 18:30~24:00  ==  UTC 09:30~15:00 (같은 UTC 날짜 안에 들어옴)
    //   09:30 = 570분, 15:00 = 900분
    match /asCheckIn/{docId} {
      allow read: if true;

      allow create: if
           // 앱(익명 인증)을 거친 요청만 — 외부에서 직접 못 만든다
           signedIn()
           // 시각은 서버 시계만 인정 — 날짜·시각 위조 불가
        && request.resource.data.at == request.time
           // 수업 시작 이후 ~ 그날 자정 이전에만
        && utcMinutes() >= 570
        && utcMinutes() <  900
           // 허용 필드 고정
        && request.resource.data.keys().hasOnly(['at','subject','name','track'])
        && request.resource.data.name is string
        && request.resource.data.subject is string;

      // 한 번 찍으면 못 바꾼다. 정정은 교사가 asOverride에 따로 남긴다.
      allow update, delete: if false;
    }

    // ── 등교 출석 체크인 (아침) ─────────────────────────
    // 기존 GAS 정책을 그대로 옮긴 것:
    //   06:00 이전 불가 / 08:30 이후 불가(→ 결석) / 상태는 학생이 고르지 않는다.
    // 출석·지각은 저장된 서버 시각으로 앱이 계산한다. 시각을 못 고르니 위조가 안 된다.
    // 결석은 저장하지 않는다 — 수업일인데 기록이 없으면 결석(방과후와 같은 규칙).
    //
    // ⚠️ KST 06:00~08:30 == UTC 21:00~23:30 (하루 전 UTC 날짜다. 자정을 넘지 않아
    //    분 단위 비교로 충분하다). 21:00 = 1260분, 23:30 = 1410분.
    match /amCheckIn/{docId} {
      allow read: if true;

      allow create: if
           signedIn()
        && request.resource.data.at == request.time
        && utcMinutes() >= 1260
        && utcMinutes() <  1410
        && request.resource.data.keys().hasOnly(['at','name','dorm'])
        && request.resource.data.name is string
        && request.resource.data.dorm is bool;

      // 한 번 찍으면 못 바꾼다. 정정은 교사가 amOverride에 남긴다.
      allow update, delete: if false;
    }

    // ── 등교 출석 교사 정정 ─────────────────────────────
    // 학생이 못 찍었지만 실제로는 왔거나, 공결 처리할 때.
    // 문서 ID가 '날짜_이름'이라 하루 한 건으로 자연히 정리된다.
    match /amOverride/{docId} {
      allow read: if true;
      allow write: if isTeacher()
                   && ( request.resource == null
                        || ( request.resource.data.keys()
                               .hasOnly(['date','name','status','by','at'])
                             && request.resource.data.status in ['출석','지각','결석','공결'] ) );
    }

    // ── 교사 출석 정정 ─────────────────────────────────────
    // 학생이 못 찍었지만 실제로는 참석한 경우 교사가 덮어쓰는 기록.
    // 교사 로그인(2026-09-14)이 생겨서 이제 규칙으로 막을 수 있다.
    match /asOverride/{docId} {
      allow read: if true;
      allow write: if isTeacher()
                   && ( request.resource == null
                        || request.resource.data.keys()
                             .hasOnly(['status','by','at','subject','name']) );
    }

    // ── 학생 명부 (엽전 잔액이 여기 있음) ───────────────────
    // 읽기 전용. 엽전이 오가는 쓰기는 전부 GAS(시트가 원본)를 거친다.
    // ⚠️ 여기에 v2 전용 필드를 추가하지 말 것 — GAS가 엽전을 바꿀 때마다,
    //    그리고 매일 새벽 3시 전체 동기화 때 이 문서를 다시 쓰기 때문이다.
    //    (프리즈를 여기 뒀다가 하룻밤 만에 사라진 사고가 있었음 → streakFreeze로 분리)
    match /members/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── 스트릭 프리즈 (v2) ─────────────────────────────────
    // 구매(보유 +1)는 엽전이 오가므로 GAS만 가능 — 규칙상 클라이언트는 늘릴 수 없다.
    // 사용(되살리기)만 앱에서 직접: 보유가 정확히 1 줄고 메운 날짜 목록이 함께 바뀔 때.
    // dates의 '내용'은 규칙으로 검증할 수 없지만, 쓸 수 있는 횟수가 구매 수량에
    // 묶여 있고 구매는 엽전을 소모하므로 경제적으로 조작이 불가능하다.
    match /streakFreeze/{name} {
      allow read: if true;
      allow update: if
           signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','dates','updatedAt'])
        && request.resource.data.count == resource.data.count - 1
        && request.resource.data.count >= 0;
      allow create, delete: if false;   // 문서 생성은 구매 시 GAS만
    }

    // ── 그 외 전부 (기존 그대로) ───────────────────────────
    // 읽기만 허용. 쓰기는 GAS(서비스 계정)가 규칙을 우회하므로 정상 동작.
    match /{document=**} {
      allow read;
      allow write: if false;
    }
  }
}
