rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// 장원급제반 Firestore 보안규칙
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 탭 → 전체 붙여넣기 → 게시
//
// ⚠️ 기존 규칙에서 바뀌는 점
//   - /schedule 은 기존 그대로 유지(앱에서 방과후 시간표를 직접 편집하므로 건드리면 안 됨)
//   - /asCheckIn  추가 — 학생 방과후 출석 체크인(신규)
//   - /asOverride 추가 — 교사 출석 정정(신규)
//   - /members    추가 — 스트릭 프리즈 구매만 좁게 허용
//   - 그 외는 기존과 동일하게 읽기만 허용, 쓰기는 GAS(서비스 계정)만
//
// ── 2026-09-14 교사 로그인 도입 ────────────────────────────────
//   - /admins    추가 — 교사 UID 명단(콘솔에서만 생성)
//   - isTeacher() 로 /asOverride 를 교사 전용으로 잠금(전에는 완전 개방)
//   - /asCheckIn, /streakFreeze 쓰기에 signedIn() 요구
//   - ⚠️ 구앱은 인증을 안 쓴다(request.auth == null). /schedule 쓰기와
//     모든 읽기에는 인증을 걸지 않았다 — 걸면 학생들 구앱이 즉시 깨진다.
//
// ── 2026-09-14 등교 출결 v2 이전 ───────────────────────────────
//   - /amCheckIn  추가 — 학생 등교 인증(KST 06:00~08:30)
//   - /amOverride 추가 — 교사 등교 출결 정정(교사만)
//
// ── 2026-09-14 엽전 계산 방식(B단계) ───────────────────────────
//   - /opening 추가 — 계산 시작 기준점(교사만 생성, 수정·삭제 불가)
//   - /ledger  추가 — 계산할 수 없는 엽전 이동(교사만, 추가만 가능)
//   - /planner 추가 — 학생 플래너. 날짜는 서버 at으로만 정해진다(소급 입력 차단)
//   - /streakFreeze 제거 → /freezeBuy, /freezeUse 로 교체(이벤트 기록).
//     이로써 v2에서 GAS로 나가는 쓰기 경로가 없어진다.
//   - /marketItem, /marketBuy 추가 — 저잣거리. 재고도 계산으로 구한다
//
// ── 2026-09-14 상담 기록 보호 ──────────────────────────────────
//   - /counseling 추가 — 교사만 읽기·쓰기(학생 개인정보)
//   - ⚠️ 맨 아래 catch-all의 "전체 읽기 허용"을 걷어냈다. 규칙은 OR이라
//     catch-all이 열려 있으면 상담 기록도 같이 읽혀서다.
//     대신 실제로 읽히는 컬렉션을 명시했다. 구앱이 읽는
//     teachers·examScores·examHistory_공기업·examHistory_공무원이
//     빠지면 학생들 앱이 깨지므로 절대 지우지 말 것.
//   - ⚠️ match 경로에 한글을 쓰면 "token recognition error"가 난다.
//     examHistory_공기업/공무원은 경로 대신 문자열 비교로 처리했다.
//
// 참고: Firestore 규칙은 "먼저 매칭된 것이 이긴다"가 아니라 **하나라도 허용하면 통과**다.
//       그래서 아래 구체 규칙들과 맨 끝 catch-all(write:false)이 공존해도 문제 없다.
//
// ⚠️ 시간은 전부 한국시간(KST=UTC+9) 기준. request.time은 UTC라 환산해서 비교한다.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // UTC 자정 기준 경과 분(0~1439)
    function utcMinutes() {
      return request.time.hours() * 60 + request.time.minutes();
    }

    // ── 신원 ────────────────────────────────────────────
    // 학생 = 익명 인증(앱이 열릴 때 조용히 로그인). 화면 변화 없음.
    // 교사 = 이메일·비밀번호 계정 중 아래 화이트리스트에 있는 사람만.
    //
    // ⚠️ 이메일/비밀번호 제공업체가 켜져 있으면 누구나 스스로 계정을
    //    만들 수 있다. "이메일 계정이 있다"는 교사의 근거가 못 된다.
    //    반드시 UID로 못박거나 admins 문서로 확인할 것.
    // ⚠️ 구앱(index.html)은 인증을 쓰지 않아 request.auth 가 null이다.
    //    그래서 구앱이 건드리는 /schedule 과 읽기 권한에는
    //    signedIn()/isTeacher()를 절대 걸면 안 된다.
    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return request.auth != null
        && ( request.auth.uid == 'c5BpZGuLVtZmKep0xq3DVeCUBij1'
             // 방과후 강사를 추가할 땐 규칙 재게시 없이 문서 하나만 만들면 된다
             || exists(/databases/$(database)/documents/admins/$(request.auth.uid)) );
    }

    // ── 교사 명단 ───────────────────────────────────────
    // 문서 ID = 교사의 UID. 생성은 Firebase 콘솔에서만(클라이언트 쓰기 금지).
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ── 방과후 시간표 (기존 그대로 — 절대 건드리지 말 것) ──────
    // 교사가 앱에서 시간표를 직접 편집하므로 쓰기가 열려 있어야 한다.
    match /schedule/{docId} {
      allow read, write: if true;
    }

    // ── 방과후 출석 체크인 (신규) ──────────────────────────
    // 학생이 수업 시작(18:30 KST) 이후 그날 24시(KST)까지 직접 찍는다.
    // 결석은 저장하지 않는다 — 기록이 없으면 결석으로 계산하므로,
    // 자정이 지나면 자동으로 결석이 확정된다(마감 트리거 불필요).
    //
    // KST 18:30~24:00  ==  UTC 09:30~15:00 (같은 UTC 날짜 안에 들어옴)
    //   09:30 = 570분, 15:00 = 900분
    match /asCheckIn/{docId} {
      allow read: if true;

      allow create: if
           // 앱(익명 인증)을 거친 요청만 — 외부에서 직접 못 만든다
           signedIn()
           // 시각은 서버 시계만 인정 — 날짜·시각 위조 불가
        && request.resource.data.at == request.time
           // 수업 시작 이후 ~ 그날 자정 이전에만
        && utcMinutes() >= 570
        && utcMinutes() <  900
           // 허용 필드 고정
        && request.resource.data.keys().hasOnly(['at','subject','name','track'])
        && request.resource.data.name is string
        && request.resource.data.subject is string;

      // 한 번 찍으면 못 바꾼다. 정정은 교사가 asOverride에 따로 남긴다.
      allow update, delete: if false;
    }

    // ── 등교 출석 체크인 (아침) ─────────────────────────
    // 기존 GAS 정책을 그대로 옮긴 것:
    //   06:00 이전 불가 / 08:30 이후 불가(→ 결석) / 상태는 학생이 고르지 않는다.
    // 출석·지각은 저장된 서버 시각으로 앱이 계산한다. 시각을 못 고르니 위조가 안 된다.
    // 결석은 저장하지 않는다 — 수업일인데 기록이 없으면 결석(방과후와 같은 규칙).
    //
    // ⚠️ KST 06:00~08:30 == UTC 21:00~23:30 (하루 전 UTC 날짜다. 자정을 넘지 않아
    //    분 단위 비교로 충분하다). 21:00 = 1260분, 23:30 = 1410분.
    match /amCheckIn/{docId} {
      allow read: if true;

      allow create: if
           signedIn()
        && request.resource.data.at == request.time
        && utcMinutes() >= 1260
        && utcMinutes() <  1410
        && request.resource.data.keys().hasOnly(['at','name','dorm'])
        && request.resource.data.name is string
        && request.resource.data.dorm is bool;

      // 한 번 찍으면 못 바꾼다. 정정은 교사가 amOverride에 남긴다.
      allow update, delete: if false;
    }

    // ── 등교 출석 교사 정정 ─────────────────────────────
    // 학생이 못 찍었지만 실제로는 왔거나, 공결 처리할 때.
    // 문서 ID가 '날짜_이름'이라 하루 한 건으로 자연히 정리된다.
    match /amOverride/{docId} {
      allow read: if true;
      allow write: if isTeacher()
                   && ( request.resource == null
                        || ( request.resource.data.keys()
                               .hasOnly(['date','name','status','by','at'])
                             && request.resource.data.status in ['출석','지각','결석','공결'] ) );
    }

    // ── 교사 출석 정정 ─────────────────────────────────────
    // 학생이 못 찍었지만 실제로는 참석한 경우 교사가 덮어쓰는 기록.
    // 교사 로그인(2026-09-14)이 생겨서 이제 규칙으로 막을 수 있다.
    match /asOverride/{docId} {
      allow read: if true;
      allow write: if isTeacher()
                   && ( request.resource == null
                        || request.resource.data.keys()
                             .hasOnly(['status','by','at','subject','name']) );
    }

    // ── 엽전 개시잔액 ───────────────────────────────────
    // v2가 엽전을 계산하기 시작하는 기준점. "그 날짜에 이 학생은 N냥이었다".
    // 한 번 정하면 바꾸지 않는다 — 기준점이 움직이면 잔액이 통째로 흔들리고,
    // 언제 무엇이 바뀌었는지 추적할 수 없게 된다. 고칠 일이 있으면 원장에 넣는다.
    // 이 문서가 없는 학생은 아직 전환 전 → 앱이 시트 값(members.coins)을 쓴다.
    match /opening/{name} {
      allow read: if true;
      allow create: if isTeacher()
                    && request.resource.data.keys().hasOnly(['date','coins','by','at'])
                    && request.resource.data.coins is int
                    && request.resource.data.date is string;
      allow update, delete: if false;
    }

    // ── 엽전 원장 ───────────────────────────────────────
    // "계산할 수 없는" 엽전 이동만 들어간다: 교사 지급·차감 등.
    // 출결로 생기는 엽전(출석·지각·결석·주간개근)은 여기 넣지 않는다 —
    // 기록에서 계산하므로, 원장에도 쌓으면 같은 사실이 두 번 반영된다.
    //
    // 추가만 가능하다. 잘못 넣었으면 반대 기록을 넣어 상쇄한다(회계 원칙).
    // 지울 수 있게 하면 "왜 잔액이 달라졌는지" 추적이 불가능해진다.
    match /ledger/{docId} {
      allow read: if true;
      allow create: if isTeacher()
                    && request.resource.data.keys()
                         .hasOnly(['name','amount','reason','by','date','at'])
                    && request.resource.data.amount is int
                    && request.resource.data.amount != 0
                    && request.resource.data.name is string
                    && request.resource.data.reason is string
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── 플래너 ──────────────────────────────────────────
    // 엽전이 걸려 있다: 100% 달성 +2 / 미작성 −1. 그래서 "며칠자 플래너인가"를
    // 학생이 정하게 두면 지난 날짜를 채워 넣어 감점을 보너스로 바꿀 수 있다.
    //
    // 그래서 날짜를 필드로 받지 않는다. 앱은 서버가 찍은 at으로만 날짜를 센다.
    // at은 만들 때 request.time으로 고정되고 이후 절대 못 바꾸므로,
    // 학생은 '지금' 날짜의 플래너만 만들 수 있다.
    match /planner/{docId} {
      allow read: if true;

      allow create: if
           signedIn()
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['name','tasks','progress','at'])
        && request.resource.data.name is string
        && request.resource.data.tasks is string          // 과제 목록 JSON
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;

      // 그날 안에서만 고칠 수 있다. at·이름은 못 바꾼다 — at이 날짜의 근거라
      // 바뀌면 지난 날짜로 옮길 수 있게 된다.
      // 18시간 제한: 아침에 쓴 플래너를 밤늦게까지 고치는 건 되고,
      // 다음 날 지난 플래너를 100%로 올리는 건 막힌다.
      allow update: if
           signedIn()
        && request.resource.data.at == resource.data.at
        && request.resource.data.name == resource.data.name
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tasks','progress'])
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100
        && request.time < resource.data.at + duration.value(18, 'h');

      allow delete: if false;
    }

    // ── 저잣거리 ────────────────────────────────────────
    // 물품은 교사가 관리한다. 재고를 문서에 들고 있지 않는다 —
    // 재고 = stock(시작 수량) − 판매 기록 합계로 계산한다.
    // 그래서 "재고는 줄었는데 엽전은 안 빠졌다" 같은 어긋남이 없고,
    // 동시에 두 명이 사도 재고가 꼬이지 않는다(문서를 고치는 게 아니라 쌓기만 한다).
    match /marketItem/{docId} {
      allow read: if true;
      allow write: if isTeacher()
                   && ( request.resource == null
                        || ( request.resource.data.keys()
                               .hasOnly(['name','price','stock','note','at'])
                             && request.resource.data.price is int
                             && request.resource.data.price >= 0
                             && request.resource.data.stock is int
                             && request.resource.data.stock >= 0 ) );
    }

    // 판매 기록. 구앱과 마찬가지로 교사가 처리한다(학생이 직접 사지 않는다)
    // — 물건을 실제로 건네주는 사람이 교사이기 때문.
    // 엽전은 이 기록에서 계산된다: −(수량 × 가격).
    match /marketBuy/{docId} {
      allow read: if true;
      allow create: if isTeacher()
                    && request.resource.data.keys()
                         .hasOnly(['student','item','qty','price','by','at'])
                    && request.resource.data.qty is int
                    && request.resource.data.qty > 0
                    && request.resource.data.price is int
                    && request.resource.data.price >= 0
                    && request.resource.data.student is string
                    && request.resource.data.item is string
                    && request.resource.data.at == request.time;
      // 취소는 반대 기록이 아니라 교사만 지울 수 있게 둔다 — 물건을 돌려받는
      // 상황이라 기록을 남기는 것보다 없애는 쪽이 재고·엽전 계산에 자연스럽다.
      allow update: if false;
      allow delete: if isTeacher();
    }

    // ── 학생 명부 (엽전 잔액이 여기 있음) ───────────────────
    // 읽기 전용. 엽전이 오가는 쓰기는 전부 GAS(시트가 원본)를 거친다.
    // ⚠️ 여기에 v2 전용 필드를 추가하지 말 것 — GAS가 엽전을 바꿀 때마다,
    //    그리고 매일 새벽 3시 전체 동기화 때 이 문서를 다시 쓰기 때문이다.
    //    (프리즈를 여기 뒀다가 하룻밤 만에 사라진 사고가 있었음 → streakFreeze로 분리)
    match /members/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── 스트릭 프리즈 ───────────────────────────────────
    // 구매·사용을 각각 문서 하나로 남긴다(이벤트). 한 동작 = 한 번의 쓰기라
    // "엽전은 빠졌는데 프리즈는 안 늘었다" 같은 어긋남이 생길 수 없다.
    // (예전엔 GAS가 엽전을 깎고 streakFreeze.count를 올리는 2단계였다.)
    //
    // 보유 수나 잔액을 규칙으로 검사하지 않는다 — 규칙은 컬렉션을 셀 수 없다.
    // 대신 앱이 "사용은 구매한 횟수만큼만" 인정하도록 계산한다(오래된 순으로 잘라냄).
    // 초과로 만든 사용 기록은 계산에서 버려지므로 기록을 늘려도 얻는 게 없다.
    // 구매 기록을 늘리면 그만큼 엽전이 깎이므로(-10 × 구매수, 계산) 이득이 없다.
    match /freezeBuy/{docId} {
      allow read: if true;
      allow create: if
           signedIn()
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['name','at'])
        && request.resource.data.name is string;
      allow update, delete: if false;
    }
    match /freezeUse/{docId} {
      allow read: if true;
      allow create: if
           signedIn()
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['name','date','at'])
        && request.resource.data.name is string
        && request.resource.data.date is string;
      allow update, delete: if false;
    }

    // ── 상담 기록 ───────────────────────────────────────
    // ⚠️ 학생 개인정보다. 아래 catch-all에서 전체 읽기 허용을 걷어냈기 때문에
    //    여기서 교사에게만 열어줄 수 있다(규칙은 OR이라 어딘가 하나라도
    //    read를 허용하면 통과한다 — 그래서 catch-all을 좁히는 게 먼저였다).
    // 같은 이유로 저장소(공개 GitHub Pages)에 시드 파일로 넣지 않는다.
    // 과거 기록 이전은 GAS 편집기 일회성 스크립트로 한다(migrate_counseling.gs).
    match /counseling/{docId} {
      allow read:  if isTeacher();
      allow write: if isTeacher()
                   && ( request.resource == null
                        || request.resource.data.keys()
                             .hasOnly(['date','name','done','memo','at']) );
    }

    // ── 읽기만 열어두는 것들 ────────────────────────────
    // 예전엔 맨 아래 catch-all이 "전부 읽기 허용"이었다. 상담 기록을 보호하려면
    // 그걸 걷어내야 해서, 실제로 읽히는 컬렉션을 여기에 명시한다.
    // ⚠️ 아래 5개는 구앱(index.html)이 읽는다 — 빠지면 학생들 앱이 깨진다.
    //    teachers·examScores·examHistory_* 는 구앱 전용, attendance는 v2 전용.
    // ⚠️ match 경로에는 한글을 쓸 수 없다(examHistory_공기업 등에서 토큰 오류).
    //    그래서 컬렉션 이름을 와일드카드로 받아 문자열로 비교한다.
    //    문자열 리터럴 안의 한글은 문제없다.
    match /{coll}/{docId} {
      allow read: if coll in ['teachers', 'examScores', 'attendance',
                              'examHistory_공기업', 'examHistory_공무원'];
    }

    // ── 그 외 전부 ─────────────────────────────────────
    // 읽기도 쓰기도 막는다. 새 컬렉션을 만들면 위에 명시적으로 열어야 한다.
    // (쓰기는 GAS 서비스 계정이 규칙을 우회하므로 기존 동작에 영향 없음)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
