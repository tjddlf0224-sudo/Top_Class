rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// 장원급제반 Firestore 보안규칙
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 탭 → 전체 붙여넣기 → 게시
//
// ⚠️ 기존 규칙에서 바뀌는 점
//   - /schedule 은 기존 그대로 유지(앱에서 방과후 시간표를 직접 편집하므로 건드리면 안 됨)
//   - /asCheckIn  추가 — 학생 방과후 출석 체크인(신규)
//   - /asOverride 추가 — 교사 출석 정정(신규)
//   - /members    추가 — 스트릭 프리즈 구매만 좁게 허용
//   - 그 외는 기존과 동일하게 읽기만 허용, 쓰기는 GAS(서비스 계정)만
//
// 참고: Firestore 규칙은 "먼저 매칭된 것이 이긴다"가 아니라 **하나라도 허용하면 통과**다.
//       그래서 아래 구체 규칙들과 맨 끝 catch-all(write:false)이 공존해도 문제 없다.
//
// ⚠️ 시간은 전부 한국시간(KST=UTC+9) 기준. request.time은 UTC라 환산해서 비교한다.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // UTC 자정 기준 경과 분(0~1439)
    function utcMinutes() {
      return request.time.hours() * 60 + request.time.minutes();
    }

    // ── 방과후 시간표 (기존 그대로 — 절대 건드리지 말 것) ──────
    // 교사가 앱에서 시간표를 직접 편집하므로 쓰기가 열려 있어야 한다.
    match /schedule/{docId} {
      allow read, write: if true;
    }

    // ── 방과후 출석 체크인 (신규) ──────────────────────────
    // 학생이 수업 시작(18:30 KST) 이후 그날 24시(KST)까지 직접 찍는다.
    // 결석은 저장하지 않는다 — 기록이 없으면 결석으로 계산하므로,
    // 자정이 지나면 자동으로 결석이 확정된다(마감 트리거 불필요).
    //
    // KST 18:30~24:00  ==  UTC 09:30~15:00 (같은 UTC 날짜 안에 들어옴)
    //   09:30 = 570분, 15:00 = 900분
    match /asCheckIn/{docId} {
      allow read: if true;

      allow create: if
           // 시각은 서버 시계만 인정 — 날짜·시각 위조 불가
           request.resource.data.at == request.time
           // 수업 시작 이후 ~ 그날 자정 이전에만
        && utcMinutes() >= 570
        && utcMinutes() <  900
           // 허용 필드 고정
        && request.resource.data.keys().hasOnly(['at','subject','name','track'])
        && request.resource.data.name is string
        && request.resource.data.subject is string;

      // 한 번 찍으면 못 바꾼다. 정정은 교사가 asOverride에 따로 남긴다.
      allow update, delete: if false;
    }

    // ── 교사 출석 정정 (신규) ──────────────────────────────
    // 학생이 못 찍었지만 실제로는 참석한 경우 교사가 덮어쓰는 기록.
    // ⚠️ 진짜 로그인이 없어 "교사임"을 규칙으로 검증할 수 없다.
    //    엽전에 영향이 없는 순수 기록이라 악용 유인은 낮아 일단 열어둔다.
    match /asOverride/{docId} {
      allow read: if true;
      allow write: if request.resource == null
                   || request.resource.data.keys().hasOnly(['status','by','at','subject','name']);
    }

    // ── 학생 명부 (엽전 잔액이 여기 있음) ───────────────────
    // 클라이언트가 엽전을 "늘리는" 방향으로는 절대 못 쓰게 한다.
    match /members/{id} {
      allow read: if true;

      // 스트릭 프리즈 구매: 엽전이 정확히 10냥 줄고 프리즈가 딱 1 늘 때만 허용.
      // 엽전만 늘리기 / 프리즈만 늘리기 / 가격 깎기는 전부 거부된다.
      // (freezes 필드가 아직 없는 학생도 있으므로 get(...,0)으로 기본값 처리)
      allow update: if
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins','freezes'])
        && request.resource.data.coins == resource.data.coins - 10
        && request.resource.data.get('freezes', 0) == resource.data.get('freezes', 0) + 1
        && request.resource.data.coins >= 0;

      allow create, delete: if false;   // 명부 추가·삭제는 GAS(교사)만
    }

    // ── 그 외 전부 (기존 그대로) ───────────────────────────
    // 읽기만 허용. 쓰기는 GAS(서비스 계정)가 규칙을 우회하므로 정상 동작.
    match /{document=**} {
      allow read;
      allow write: if false;
    }
  }
}
